<?xml version="1.0" encoding="utf-8"?>
<!--
    android_patches/app/src/main/res/values/styles.xml
    ──────────────────────────────────────────────────
    This file contains ONLY Theme.TranslatePopup.

    It is NOT copied over the generated styles.xml.  Instead, the CI script
    injects the <style> block into the flutter-generated styles.xml using sed,
    so that LaunchTheme and NormalTheme (produced by `flutter create`) are
    preserved untouched.

    Parent: @android:style/Theme.Translucent.NoTitleBar
      • Pure Android platform theme — no AppCompat dependency required.
      • FlutterActivity extends android.app.Activity (not AppCompatActivity),
        so AppCompat themes are unnecessary and would fail without the library.
      • Theme.Translucent.NoTitleBar already sets windowIsTranslucent=true and
        windowNoTitle=true, so those attributes are inherited automatically.

    windowIsFloating=true:
      • Makes Android treat the window as a dialog-sized floating surface.
      • FlutterActivity's onStart() overrides window.setLayout() to
        MATCH_PARENT × WRAP_CONTENT so Flutter gets a bounded width constraint
        and the card height is determined by Flutter's intrinsic layout.
-->
<resources>

    <style name="Theme.TranslatePopup" parent="@android:style/Theme.Translucent.NoTitleBar">
        <!-- Inherited from Theme.Translucent.NoTitleBar:
             android:windowIsTranslucent = true
             android:windowNoTitle       = true
             The items below only add or override on top of that base. -->
        <item name="android:windowIsFloating">true</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:backgroundDimEnabled">true</item>
        <item name="android:backgroundDimAmount">0.5</item>
        <item name="android:windowAnimationStyle">@android:style/Animation.Dialog</item>
        <!-- Prevent minimum-width constraints imposed by the Dialog base theme -->
        <item name="android:windowMinWidthMajor">0%</item>
        <item name="android:windowMinWidthMinor">0%</item>
    </style>

</resources>
