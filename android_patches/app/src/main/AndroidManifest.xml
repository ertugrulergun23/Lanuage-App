<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.example.language_app">

    <!-- INTERNET permission is declared directly here.
         The CI/CD script copies this file as-is — no sed injection needed. -->
    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:label="language_app"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher">

        <!-- ══════════════════════════════════════════════════════════════════
             Main application Activity.
             Unchanged from the original — singleTop, MAIN/LAUNCHER.
             ══════════════════════════════════════════════════════════════════ -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|tilt"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <!-- Splash theme shown while Flutter initialises -->
            <meta-data
                android:name="io.flutter.embedding.android.NormalTheme"
                android:resource="@style/NormalTheme" />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>

        <!-- ══════════════════════════════════════════════════════════════════
             Floating / translucent Popup Activity.

             Key attributes explained:
               • android:theme          → translucent fullscreen (no dialog chrome)
               • android:taskAffinity="" → isolated task, won't merge into main task
               • android:excludeFromRecents="true" → won't pollute the Recents list
               • android:launchMode="singleTask" → only one popup at a time
               • android:exported="true" → required for external apps to trigger it

             The PROCESS_TEXT intent-filter is on THIS activity, NOT MainActivity,
             so the main app is never brought to the foreground.
             ══════════════════════════════════════════════════════════════════ -->
        <activity
            android:name=".TranslatePopupActivity"
            android:exported="true"
            android:theme="@style/Theme.TranslatePopup"
            android:taskAffinity=""
            android:excludeFromRecents="true"
            android:launchMode="singleTask">
            <!-- Label shown in the text-selection "Share/Process" menu -->
            <intent-filter android:label="LingoLib — Translate">
                <action android:name="android.intent.action.PROCESS_TEXT" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
        </activity>

        <!-- Flutter embedding v2 — do not delete -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
    </application>
</manifest>
